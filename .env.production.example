# Production backend configuration template for ThinkPulse
# Copy values into your deployment provider environment variables. Do not commit real secrets.

NODE_ENV=production
MODE=live
PORT=8080
PUBLIC_BASE_URL=https://your-backend.example.com

# Restrict browser origins. Add your published Chrome extension ID after publication.
CORS_ORIGINS=chrome-extension://your_published_extension_id,https://your-backend.example.com

# Published Chrome extension origin(s). Required so the backend trusts requests
# from the released extension when CORS_ORIGINS is reserved for web origins.
CHROME_EXTENSION_ORIGINS=chrome-extension://your_published_extension_id

# Razorpay live configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_URL=https://your-backend.example.com/webhooks

# Supabase persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Stripe live configuration
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_LIVE=
WEBHOOK_URL=https://your-backend.example.com/stripe/webhook
STRIPE_PRICE_BASIC_EXAM_INR_10=
STRIPE_PRICE_PREMIUM_EXAM_INR_20=

# Legal/payment URLs
TERMS_URL=https://your-backend.example.com/terms
PRIVACY_URL=https://your-backend.example.com/privacy
REFUND_POLICY_URL=https://your-backend.example.com/refund-policy
SUCCESS_URL=https://your-backend.example.com/billing/success
CANCEL_URL=https://your-backend.example.com/billing/cancel

# Support details
SUPPORT_EMAIL=
SUPPORT_PHONE=
STRIPE_STATEMENT_DESCRIPTOR=THINKPULSE

# Managed provider keys
ADMIN_OPENROUTER_KEYS=
ADMIN_GEMINI_KEYS=
ADMIN_DEEPSEEK_KEY=
ADMIN_QWEN_KEY=
ADMIN_LLAMA_PRIMARY_KEY=
ADMIN_VISION_KEY=
ADMIN_IMAGE_GEN_KEY=
ADMIN_OCRSPACE_KEY=
ADMIN_NVIDIA_OCR_KEY=
ADMIN_ASR_KEY=
DEFAULT_TAVILY_SEARCH_KEYS=
DEFAULT_SERPER_SEARCH_KEYS=

# Superior LLM (system-managed primary chat route) + automatic fallback.
# Primary is DeepSeek; if it fails before streaming, requests fall back to
# NVIDIA Nemotron via the OpenAI-compatible NIM endpoint.
SUPERIOR_LLM_API=
SUPERIOR_LLM_PROVIDER=deepseek
SUPERIOR_LLM_MODEL=deepseek-chat
SUPERIOR_LLM_ENDPOINT=https://api.deepseek.com/chat/completions
SUPERIOR_LLM_FALLBACK_API=
SUPERIOR_LLM_FALLBACK_PROVIDER=nvidia
SUPERIOR_LLM_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
SUPERIOR_LLM_FALLBACK_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions

# User secret encryption for stored BYOK credentials
THINKPULSE_API_KEY_ENCRYPTION_SECRET=
